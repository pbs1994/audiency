# Supabase project settings: Project Settings → API in the Supabase dashboard.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secret — server-only. Never prefix with NEXT_PUBLIC_, never commit it.
# Bypasses Row Level Security: used only by src/lib/supabase/admin.ts
# to place orders after the caller's session has already been verified.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
