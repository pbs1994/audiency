# Supabase project settings: Project Settings → API in the Supabase dashboard.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Secret — server-only. Never prefix with NEXT_PUBLIC_, never commit it.
# Bypasses Row Level Security: used only by src/lib/supabase/admin.ts
# to place orders after the caller's session has already been verified.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Paddle — Developer tools → Authentication. Use sandbox values + NEXT_PUBLIC_PADDLE_ENV=sandbox for testing.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
NEXT_PUBLIC_PADDLE_ENV=production
# Secret — server-only. Creates transactions.
PADDLE_API_KEY=pdl_live_apikey_...
# Catalog product that non-catalog prices attach to.
PADDLE_PRODUCT_ID=pro_...
# Secret — verifies webhook signatures (Developer tools → Notifications → endpoint secret).
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
